<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 차량(AAOS) 앱. 일반 에뮬레이터/태블릿에서도 설치되도록 required=false -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Pleos Vehicle SDK: Gear·Odometer = CAR_DRIVE, TurnSignal = CAR_LIGHTS (AAR @RequiresPermission 로 확인) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <!-- NaviHelper: get*Info() 계열 = NAVI_ROUTE (문서 Declaring permissions) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- TextToSpeech SDK: TTS_SERVICE (문서 Declaring permissions) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <application
        android:name=".DriveApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Drive">

        <!-- distractionOptimized 메타데이터를 선언하지 않는다:
             주행 중(UX 제한 활성)에는 시스템이 이 액티비티를 막고, 앱 자체도 기어가 P가 아니면 빈 화면을 보여 준다. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
